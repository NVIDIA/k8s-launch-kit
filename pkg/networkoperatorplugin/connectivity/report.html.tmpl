{{define "target-style"}}{{/* Manifest-row + expand-row pairing. The expand row carries the
   dropdowns (Details, Live YAML) full-width via colspan="6" so the
   nested table / <pre> have the whole table width to lay out in.
   When a manifest row has an expand row below, suppress its own
   bottom border so the pair reads as one visual unit. */}}
tr.manifest-row-has-expand > td { border-bottom-color: transparent; }
tr.manifest-expand > td { background: var(--bg); }
tr.manifest-expand:hover > td { background: var(--bg); }
.manifest-expand-cell {
  padding: 4px 14px 14px 28px !important;
  border-bottom: 1px solid var(--border);
}
.manifest-expand-cell > details {
  margin-top: 6px;
  padding-top: 0;
  border-top: 0;
}
.manifest-expand-cell > details:first-child { margin-top: 0; }
{{/* Re-apply the per-row state stripe to the expand row's first td
   so the colored bar runs unbroken from parent to expand row. */}}
tr.manifest-expand.state-success    > td { box-shadow: inset 2px 0 0 var(--success); }
tr.manifest-expand.state-inprogress > td { box-shadow: inset 2px 0 0 var(--warn); }
tr.manifest-expand.state-error      > td { box-shadow: inset 2px 0 0 var(--error); }
tr.manifest-expand.state-missing    > td { box-shadow: inset 2px 0 0 var(--missing); }

.yaml-block {
  margin-top: 6px;
  padding: 12px 14px;
  background: var(--bg-code);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  font-size: 12px;
  line-height: 1.5;
  color: var(--text);
  white-space: pre;
  overflow-x: auto;
  max-height: 360px;
  overflow-y: auto;
}

/* Matrix tables — separate styling so they don't share the
   manifest-table padding. */
.matrix-table {
  border: 1px solid var(--border);
  border-radius: 6px;
  margin: 14px 0;
  overflow: hidden;
}
.matrix-table th, .matrix-table td {
  text-align: center;
  font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace;
  font-size: 12.5px;
  padding: 8px 12px;
}
.matrix-table th:first-child, .matrix-table td:first-child {
  text-align: left;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
}
.matrix-table tr:hover td { background: transparent; }
.cell-pass    { background: var(--success-bg); color: var(--success); }
.cell-fail    { background: var(--error-bg);   color: var(--error); font-weight: 600; }
.cell-observe { background: var(--bg-soft);    color: var(--text-muted); font-weight: 500; }
.cell-missing { background: var(--bg-soft);    color: var(--text-faint); }
.cell-self    { color: var(--text-faint); }

.gateway-table { margin-top: 14px; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
.gateway-head, .gateway-row > summary {
  display: grid;
  grid-template-columns: minmax(0, 2.1fr) minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr) 76px 80px;
  gap: 14px;
  align-items: center;
  padding: 12px 14px;
}
.gateway-head { background: var(--bg-soft); color: var(--text-muted); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .4px; }
.gateway-row { margin: 0; padding: 0; border-top: 1px solid var(--border); }
.gateway-row > summary { color: var(--text); font-size: 13px; list-style: none; }
.gateway-row > summary::before { display: none; }
.gateway-row > summary:hover { background: var(--bg-soft); }
.gateway-row > summary > span { min-width: 0; overflow-wrap: anywhere; }
.gateway-source strong { display: block; font-weight: 500; }
.gateway-source small, .gateway-rail small { display: block; margin-top: 3px; color: var(--text-muted); font-size: 11px; }
.gateway-action { color: var(--link); font-size: 12px; }
.gateway-action::before { content: "▸ "; }
.gateway-row[open] .gateway-action::before { content: "▾ "; }
.gateway-panel { padding: 0 14px 14px; }
.gateway-panel p { margin: 8px 0; }
.gateway-evidence { white-space: pre-wrap; overflow-wrap: anywhere; max-height: 260px; }
@media (max-width: 700px) {
  .gateway-head { display: none; }
  .gateway-row > summary { grid-template-columns: 1fr 1fr; gap: 10px; }
  .gateway-source { grid-column: 1 / -1; }
  .gateway-source-ip::before { content: "Source: "; color: var(--text-muted); }
  .gateway-destination::before { content: "Gateway: "; color: var(--text-muted); }
}

.matrix-rail {
  margin-top: 14px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
}
.matrix-rail code { font-size: 12px; color: var(--text); }

/* Colour-coded headers for the paired Actual / Expected PF
 * sub-tables. Actual = red ("this is what the cluster has;
 * the highlighted rows are wrong"). Expected = orange ("this
 * is what the certified topology says; the highlighted rows
 * are what's missing or mismatched"). */
.matrix-rail.pf-section-actual {
  color: #991B1B;                            /* red-800 */
  background: rgba(220, 38, 38, 0.10);
  border-left: 3px solid #DC2626;            /* red-600 */
  padding: 6px 10px;
  border-radius: 4px;
}
.matrix-rail.pf-section-expected {
  color: #9A3412;                            /* orange-800 */
  background: rgba(234, 88, 12, 0.10);
  border-left: 3px solid #EA580C;            /* orange-600 */
  padding: 6px 10px;
  border-radius: 4px;
}

.nodegroup {
  border-top: 1px solid var(--border);
  padding-top: 20px;
  margin-top: 20px;
}
.nodegroup:first-child {
  border-top: 0;
  padding-top: 0;
  margin-top: 0;
}
.nodegroup-head {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12px;
}
.nodegroup-head code {
  font-size: 15px;
  background: transparent;
  border: 0;
  padding: 0;
  color: var(--link);
}
.nodegroup-meta {
  margin-bottom: 10px;
}
.cap-pill {
  display: inline-block;
  margin-right: 6px;
  padding: 2px 8px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.4px;
  color: var(--brand-dark);
  background: rgba(118, 185, 0, 0.10);
  border: 1px solid rgba(118, 185, 0, 0.30);
  border-radius: 10px;
}

/* Platform-topology diff styling. The PF section renders paired
 * Actual / Expected sub-tables; rows that don't match their
 * counterpart in the other table are tinted amber. The reader
 * scans down both tables and the divergence is obvious without
 * inline annotations. */
.mismatch-inline {
  color: #B45309;       /* amber-700, contrast against the row */
  font-size: 11px;
  margin-left: 6px;
}
/* Mismatched rows take their tint from the table they're in,
 * matching the section header: red in Actual, orange in
 * Expected. The adjacent-sibling combinator targets the <table>
 * that immediately follows each section header div. */
.matrix-rail.pf-section-actual + table tr.pf-mismatched {
  background: rgba(220, 38, 38, 0.12);
}
.matrix-rail.pf-section-actual + table tr.pf-mismatched td {
  border-top: 1px solid rgba(220, 38, 38, 0.32);
  border-bottom: 1px solid rgba(220, 38, 38, 0.32);
}
.matrix-rail.pf-section-expected + table tr.pf-mismatched {
  background: rgba(234, 88, 12, 0.12);
}
.matrix-rail.pf-section-expected + table tr.pf-mismatched td {
  border-top: 1px solid rgba(234, 88, 12, 0.32);
  border-bottom: 1px solid rgba(234, 88, 12, 0.32);
}

{{end}}
{{define "body"}}
<section>
  <h2>Profile</h2>
  <div class="body">
    <dl class="kv">
      <dt>Fabric</dt>          <dd>{{or .Profile.Fabric "—"}}</dd>
      <dt>Deployment</dt>      <dd>{{or .Profile.DeploymentType "—"}}</dd>
      <dt>Multirail</dt>       <dd>{{.Profile.Multirail}}</dd>
      {{- if .Profile.SpectrumX}}
      <dt>Spectrum-X</dt>      <dd>{{.Profile.SpectrumX.Version}} (mode={{.Profile.SpectrumX.MultiplaneMode}}, planes={{.Profile.SpectrumX.NumberOfPlanes}})</dd>
      {{- end}}
    </dl>
  </div>
</section>

<section>
  <h2>Node groups ({{len .NodeGroups}})</h2>
  <div class="body">
    {{- if .PresetMatches}}
    <div class="matrix-rail">Platform topology validation</div>
    <table>
      <thead>
        <tr><th>Group</th><th>Machine</th><th>GPU</th><th>Status</th><th>Detail</th></tr>
      </thead>
      <tbody>
        {{- range .PresetMatches}}
        <tr class="{{presetStatusClass .Status}}">
          <td><code>{{or .Group "—"}}</code></td>
          <td>{{or .MachineType "—"}}</td>
          <td>{{or .GPUType "—"}}</td>
          <td><span class="badge {{presetStatusClass .Status}}">{{presetStatusLabel .Status}}</span></td>
          <td>
            {{- if eq (printf "%s" .Status) "match"}}
            matches certified topology for <code>{{.PresetName}}</code> server type
            {{- else if eq (printf "%s" .Status) "deviation"}}
            does not match certified topology for <code>{{.PresetName}}</code> server type · {{.Reason}}
            {{- else if eq (printf "%s" .Status) "not-found"}}
            no certified topology available for this server type · {{.Reason}}
            {{- else}}
            {{.Reason}}
            {{- end}}
          </td>
        </tr>
        {{- end}}
      </tbody>
    </table>
    {{- end}}

    {{- if .NodeGroups}}
    {{- range .NodeGroups}}
    <div class="nodegroup">
      <div class="nodegroup-head">
        <code>{{.Identifier}}</code>
        {{- if .MachineType}} · <span class="muted">{{.MachineType}}</span>{{end}}
        {{- if .GPUType}} · <span class="muted">{{.GPUType}}</span>{{end}}
        {{- if .LinkType}} · <span class="muted">{{.LinkType}}</span>{{end}}
      </div>
      <dl class="kv nodegroup-meta">
        {{- if .NodeSelector}}
        <dt>Node selector</dt>
        <dd>
          {{- range $k, $v := .NodeSelector -}}
          <code>{{$k}}={{$v}}</code>
          {{end}}
        </dd>
        {{- end}}
        {{- if .WorkerNodes}}
        <dt>Worker nodes ({{len .WorkerNodes}})</dt>
        <dd>{{range $i, $n := .WorkerNodes}}{{if gt $i 0}}, {{end}}<code>{{$n}}</code>{{end}}</dd>
        {{- end}}
        <dt>Capabilities</dt>
        <dd>
          {{- if .SriovCapable}}<span class="cap-pill">sriov</span>{{end -}}
          {{- if .RdmaCapable}}<span class="cap-pill">rdma</span>{{end -}}
          {{- if .IbCapable}}<span class="cap-pill">ib</span>{{end -}}
          {{- if and (not .SriovCapable) (not .RdmaCapable) (not .IbCapable)}}<span class="muted">none</span>{{end}}
        </dd>
        {{- if .PresetApplied}}
        <dt>Certified topology</dt><dd>applied</dd>
        {{- end}}
      </dl>

      {{- if .EastWestPFs}}
      <div class="matrix-rail{{if or .PFCountMismatch (pfsHaveMismatch .EastWestPFs)}} pf-section-actual{{end}}">East-west PFs — Actual ({{if .PFCountMismatch}}{{.PFCountMismatch.Got}} <span class="mismatch-inline">certified topology expects {{.PFCountMismatch.Expected}}</span>{{else}}{{len .EastWestPFs}}{{end}})</div>
      <table>
        <thead><tr><th>PCI</th><th>Device ID</th><th>Rail</th><th>Netdev</th><th>RDMA</th><th>PSID</th><th>Part #</th><th>NUMA</th><th>GPU</th></tr></thead>
        <tbody>
          {{- range .EastWestPFs}}
          <tr{{if .Mismatched}} class="pf-mismatched"{{end}}>
            <td><code>{{.PciAddress}}</code></td>
            <td><code>{{or .DeviceID "—"}}</code></td>
            <td>{{.Rail}}</td>
            <td><code>{{or .NetworkInterface "—"}}</code></td>
            <td><code>{{or .RdmaDevice "—"}}</code></td>
            <td>{{or .PSID "—"}}</td>
            <td>{{or .PartNumber "—"}}</td>
            <td>{{or .NumaNode "—"}}</td>
            <td>{{or .ConnectedGPU "—"}}{{if .GPUProximity}} ({{.GPUProximity}}){{end}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- end}}

      {{- if .ExpectedEastWestPFs}}
      <div class="matrix-rail{{if pfsHaveMismatch .ExpectedEastWestPFs}} pf-section-expected{{end}}">East-west PFs — Expected by certified topology ({{len .ExpectedEastWestPFs}})</div>
      <table>
        <thead><tr><th>PCI</th><th>Device ID</th><th>Rail</th><th>Netdev</th><th>RDMA</th><th>PSID</th><th>Part #</th><th>NUMA</th><th>GPU</th></tr></thead>
        <tbody>
          {{- range .ExpectedEastWestPFs}}
          <tr{{if .Mismatched}} class="pf-mismatched"{{end}}>
            <td><code>{{.PciAddress}}</code></td>
            <td><code>{{or .DeviceID "—"}}</code></td>
            <td>{{.Rail}}</td>
            <td><code>{{or .NetworkInterface "—"}}</code></td>
            <td><code>{{or .RdmaDevice "—"}}</code></td>
            <td>{{or .PSID "—"}}</td>
            <td>{{or .PartNumber "—"}}</td>
            <td>{{or .NumaNode "—"}}</td>
            <td>{{or .ConnectedGPU "—"}}{{if .GPUProximity}} ({{.GPUProximity}}){{end}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- end}}

      {{- if .NorthSouthPFs}}
      <div class="matrix-rail{{if pfsHaveMismatch .NorthSouthPFs}} pf-section-actual{{end}}">North-south PFs — Actual ({{len .NorthSouthPFs}})</div>
      <table>
        <thead><tr><th>PCI</th><th>Device ID</th><th>Netdev</th><th>RDMA</th><th>PSID</th><th>Part #</th></tr></thead>
        <tbody>
          {{- range .NorthSouthPFs}}
          <tr{{if .Mismatched}} class="pf-mismatched"{{end}}>
            <td><code>{{.PciAddress}}</code></td>
            <td><code>{{or .DeviceID "—"}}</code></td>
            <td><code>{{or .NetworkInterface "—"}}</code></td>
            <td><code>{{or .RdmaDevice "—"}}</code></td>
            <td>{{or .PSID "—"}}</td>
            <td>{{or .PartNumber "—"}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- end}}

      {{- if .ExpectedNorthSouthPFs}}
      <div class="matrix-rail{{if pfsHaveMismatch .ExpectedNorthSouthPFs}} pf-section-expected{{end}}">North-south PFs — Expected by certified topology ({{len .ExpectedNorthSouthPFs}})</div>
      <table>
        <thead><tr><th>PCI</th><th>Device ID</th><th>Netdev</th><th>RDMA</th><th>PSID</th><th>Part #</th></tr></thead>
        <tbody>
          {{- range .ExpectedNorthSouthPFs}}
          <tr{{if .Mismatched}} class="pf-mismatched"{{end}}>
            <td><code>{{.PciAddress}}</code></td>
            <td><code>{{or .DeviceID "—"}}</code></td>
            <td><code>{{or .NetworkInterface "—"}}</code></td>
            <td><code>{{or .RdmaDevice "—"}}</code></td>
            <td>{{or .PSID "—"}}</td>
            <td>{{or .PartNumber "—"}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- end}}
    </div>
    {{- end}}
    {{- else}}
    <p class="empty">No cluster groups discovered. Run <code>l8k discover</code> to populate cluster-config.yaml.</p>
    {{- end}}
  </div>
</section>

{{- if .NVAIE}}
<section>
  <h2>NVIDIA AI Enterprise {{.NVAIE.Release}} compliance</h2>
  <div class="body">
    <table><thead><tr><th>Component</th><th>Expected</th><th>Discovered</th><th>Match</th></tr></thead><tbody>
    {{- range nvaieReportRows .NVAIE}}
      <tr><td>{{.Component}}{{if .Nodes}}<br><small>{{range $i, $node := .Nodes}}{{if $i}}, {{end}}{{$node}}{{end}}</small>{{end}}{{if .Scope}}<br><small>{{.Scope}}</small>{{end}}</td><td>{{.Expected}}</td><td>{{.Discovered}}</td><td><span class="badge {{if eq .Match "PASS"}}state-success{{else if eq .Match "FAIL"}}state-error{{else}}state-unknown{{end}}">{{.Match}}</span></td></tr>
    {{- end}}
    </tbody></table>
  </div>
</section>
{{- end}}

<section>
  <h2>Cluster nodes ({{len .Nodes}})</h2>
  <div class="body">
    {{- if .Nodes}}
    <table>
      <thead>
        <tr><th>Name</th><th>Machine label</th><th>GPU label</th><th>Role</th></tr>
      </thead>
      <tbody>
        {{- range .Nodes}}
        <tr>
          <td><code>{{.Name}}</code></td>
          <td>{{or .MachineLabel "—"}}</td>
          <td>{{or .GpuLabel "—"}}</td>
          <td>{{or .Role "—"}}</td>
        </tr>
        {{- end}}
      </tbody>
    </table>
    {{- else}}
    <p class="empty">No nodes discovered.</p>
    {{- end}}
  </div>
</section>

<section>
  <h2>Network Operator release</h2>
  <div class="body">
    {{- if .Release}}
      {{- if .Release.Skipped}}
      <p class="empty">Version check skipped: {{.Release.Reason}}</p>
      {{- else}}
      <dl class="kv">
        <dt>Selected release</dt>     <dd>{{.Release.SelectedRelease}}</dd>
        <dt>Expected appVersion</dt>  <dd><code>{{.Release.ExpectedVersion}}</code></dd>
        {{- if .Release.DeployedRelease}}
        <dt>Deployed</dt>             <dd><code>{{.Release.DeployedRelease.AppVersion}}</code> (chart {{.Release.DeployedRelease.ChartVersion}}, rev {{.Release.DeployedRelease.Revision}}, {{.Release.DeployedRelease.Status}})</dd>
        {{- end}}
        <dt>Result</dt>
        <dd>
          {{- if .Release.Match}}
          <span class="badge state-success">MATCH</span>
          {{- else}}
          <span class="badge state-error">MISMATCH</span>
          {{- end}}
        </dd>
      </dl>
      {{- end}}
    {{- else}}
    <p class="empty">No release information available.</p>
    {{- end}}

    {{- if .ComponentCheck}}
    <div class="matrix-rail">Component versions in cluster CRs</div>
    {{- if .ComponentCheck.Skipped}}
    <p class="empty">Component-version check skipped: {{.ComponentCheck.Reason}}</p>
    {{- else if .ComponentCheck.Components}}
    <table>
      <thead>
        <tr><th>Status</th><th>Source</th><th>Section</th><th>Expected</th><th>Actual</th></tr>
      </thead>
      <tbody>
        {{- range .ComponentCheck.Components}}
        <tr class="{{if .Match}}state-success{{else}}state-error{{end}}">
          <td><span class="badge {{if .Match}}state-success{{else}}state-error{{end}}">{{if .Match}}MATCH{{else}}MISMATCH{{end}}</span></td>
          <td><code>{{.Source}}</code></td>
          <td><code>{{.Section}}</code></td>
          <td><code>{{.Expected}}</code></td>
          <td><code>{{.Actual}}</code></td>
        </tr>
        {{- end}}
      </tbody>
    </table>
    {{- else}}
    <p class="empty">No version-bearing sections found in cluster CRs.</p>
    {{- end}}
    {{- end}}

    {{- if and .HelmValues (not .HelmValues.Skipped)}}
    <div class="matrix-rail">Helm values (deployed vs. generated)</div>
    {{- if .HelmValues.AllMatch}}
    <p>Deployed helm values match the generated <code>values.yaml</code>. Release <code>{{.HelmValues.ReleaseName}}</code> in <code>{{.HelmValues.Namespace}}</code>.</p>
    {{- else}}
    <p>Deployed helm values diverge from the generated <code>values.yaml</code>. Run <code>l8k deploy --overwrite-existing</code> to converge.</p>
    <table>
      <thead>
        <tr><th>Path</th><th>Deployed</th><th>Generated</th></tr>
      </thead>
      <tbody>
        {{- range .HelmValues.Diff}}
        <tr class="state-error">
          <td><code>{{.Path}}</code></td>
          <td><code>{{.Deployed}}</code></td>
          <td><code>{{.Generated}}</code></td>
        </tr>
        {{- end}}
      </tbody>
    </table>
    {{- end}}
    {{- end}}

    {{- if and .StrayCRs (not .StrayCRs.Skipped)}}
    <div class="matrix-rail">Conflicting Network Operator resources</div>
    {{- if .StrayCRs.Mismatches}}
    <p>The operator namespace already contains Network Operator resources that <code>l8k generate</code> did not produce — a previously-deployed configuration that conflicts with the rendered manifests. Run <code>l8k deploy --overwrite-existing</code> to delete them.</p>
    <table>
      <thead>
        <tr><th>Object</th><th>Kind / Scope</th></tr>
      </thead>
      <tbody>
        {{- range .StrayCRs.Mismatches}}
        <tr class="state-error">
          <td><code>{{.Path}}</code></td>
          <td>{{.Detail}}</td>
        </tr>
        {{- end}}
      </tbody>
    </table>
    {{- else}}
    <p>No conflicting Network Operator resources in the operator namespace.</p>
    {{- end}}
    {{- end}}
  </div>
</section>

<section>
  <h2>Manifest state ({{len .Manifests}})</h2>
  <div class="body">
    {{- if .Manifests}}
    <table>
      <thead>
        <tr>
          <th>State</th>
          <th>Kind</th>
          <th>Namespace</th>
          <th>Name</th>
          <th>Source file</th>
          <th>Reason</th>
        </tr>
      </thead>
      <tbody>
        {{- range .Manifests}}
        {{- $details := .Details}}
        {{- $hasExpand := or $details .LiveYAML}}
        <tr class="{{stateClass .State}}{{if $hasExpand}} manifest-row-has-expand{{end}}">
          <td><span class="badge {{stateClass .State}}">{{if .Skipped}}UNVERIFIED{{else}}{{stateLabel .State}}{{end}}</span></td>
          <td><code>{{.Kind}}</code></td>
          <td>{{or .Namespace "—"}}</td>
          <td><code>{{.Name}}</code></td>
          <td><code>{{.SourceFile}}</code></td>
          <td>{{or .Reason "—"}}</td>
        </tr>
        {{- if $hasExpand}}
        <tr class="manifest-expand {{stateClass .State}}">
          <td colspan="6" class="manifest-expand-cell">
            {{- if $details}}
            <details>
              <summary>Details ({{len $details}})</summary>
              <table>
                <thead><tr><th>Component</th><th>State</th></tr></thead>
                <tbody>
                  {{- range $k := sortedKeys $details}}
                  <tr><td><code>{{$k}}</code></td><td>{{index $details $k}}</td></tr>
                  {{- end}}
                </tbody>
              </table>
            </details>
            {{- end}}
            {{- if .LiveYAML}}
            <details>
              <summary>Live YAML</summary>
              <pre class="yaml-block">{{.LiveYAML}}</pre>
            </details>
            {{- end}}
          </td>
        </tr>
        {{- end}}
        {{- end}}
      </tbody>
    </table>
    {{- else}}
    <p class="empty">No manifests to validate.</p>
    {{- end}}
  </div>
</section>

<section>
  <h2>Connectivity matrix</h2>
  <div class="body">
    {{- if .Matrix}}
      {{- if .Matrix.Skipped}}
      <p class="empty">Connectivity skipped: {{.Matrix.Skipped.Reason}}</p>
      {{- else if .Matrix.PingResults}}
      <p class="summary-line">
        <strong>{{.Matrix.Summary.Passed}}</strong>/{{.Matrix.Summary.TotalTests}} passed
        {{- if gt .Matrix.Summary.Failed 0}} · <strong>{{.Matrix.Summary.Failed}}</strong> failed{{end}}
        {{- if gt .Matrix.Summary.Skipped 0}} · <strong>{{.Matrix.Summary.Skipped}}</strong> skipped{{end}}
      </p>

      {{- $gateways := gatewayResults .Matrix.PingResults}}
      {{- if $gateways}}
      <div class="matrix-rail">Gateway ICMP reachability</div>
      <p>ICMP echo reachability does not by itself diagnose neighbor resolution.</p>
      <div class="gateway-table">
        <div class="gateway-head"><span>Source</span><span>Rail / interface</span><span>Source IP</span><span>Gateway</span><span>Result</span><span></span></div>
        {{- range $gateways}}
        <details class="gateway-row">
          <summary>
            <span class="gateway-source"><strong>{{srcLabel .Test}}</strong><small>{{.Test.SrcNamespace}}/{{.Test.SrcPod}}</small></span>
            <span class="gateway-rail">{{.Test.SrcRail}}<small>{{.Test.SrcIface}}</small></span>
            <span class="gateway-source-ip">{{.Test.SrcIP}}</span><span class="gateway-destination">{{.Test.DstIP}}</span>
            <span class="gateway-result"><span class="badge {{if .SkipReason}}state-unknown{{else if .OK}}state-success{{else}}state-error{{end}}">{{if .SkipReason}}SKIPPED{{else if .OK}}PASSED{{else}}FAILED{{end}}</span></span>
            <span class="gateway-action">Evidence</span>
          </summary>
          <div class="gateway-panel">
            {{- if .SkipReason}}<p>Skipped: {{.SkipReason}}</p>{{end}}
            {{- if .Err}}<pre class="yaml-block gateway-evidence">Error / probe command:
{{errorText .Err}}</pre>{{end}}
            {{- if .GatewayEvidence}}<pre class="yaml-block gateway-evidence">Gateway configuration / discovery:
{{.GatewayEvidence}}</pre>{{end}}
            {{- if or .Route.Command .Route.Output .Route.Err}}<pre class="yaml-block gateway-evidence">Route command:
{{.Route.Command}}
Route output:
{{.Route.Output}}
{{if .Route.Err}}Route error:
{{.Route.Err}}{{end}}</pre>{{end}}
            {{- if .Stdout}}<pre class="yaml-block gateway-evidence">Probe stdout:
{{.Stdout}}</pre>{{end}}
            {{- if .Stderr}}<pre class="yaml-block gateway-evidence">Probe stderr:
{{.Stderr}}</pre>{{end}}
          </div>
        </details>
        {{- end}}
      </div>
      {{- end}}

      {{- $rails := matrixByRail .Matrix.PingResults}}
      {{- range $rails}}
        {{- $fam := .Family}}
        <div class="matrix-rail">Rail <code>{{.Rail}}</code> — {{familyTitle $fam}}</div>
        <table class="matrix-table">
          <thead>
            <tr>
              <th>src \ dst</th>
              {{- range .Nodes}}
              <th>{{.}}</th>
              {{- end}}
            </tr>
          </thead>
          <tbody>
            {{- $rs := .}}
            {{- range $src := .Nodes}}
            <tr>
              <td>{{$src}}</td>
              {{- range $dst := $rs.Nodes}}
                {{- if eq $src $dst}}
                <td class="cell-self">—</td>
                {{- else}}
                  {{- $cell := index (index $rs.Table $src) $dst}}
                  <td class="{{cellClass $cell}}">{{cellText $cell $fam}}</td>
                {{- end}}
              {{- end}}
            </tr>
            {{- end}}
          </tbody>
        </table>
      {{- end}}

      {{- $crossSections := matrixCrossRail .Matrix.PingResults}}
      {{- range $crossSections}}
        {{- $fam := .Family}}
        <div class="matrix-rail">Cross-rail canary — {{familyTitle $fam}}</div>
        <table class="matrix-table">
          <thead>
            <tr><th>Source</th><th>Src rail</th><th>Src iface</th><th>Destination</th><th>Dst rail</th><th>Dst iface</th><th>Result</th></tr>
          </thead>
          <tbody>
            {{- range .Results}}
            <tr>
              <td>{{srcLabel .Test}}</td>
              <td><code>{{.Test.SrcRail}}</code></td>
              <td><code>{{.Test.SrcIface}}</code></td>
              <td>{{dstLabel .Test}}</td>
              <td><code>{{.Test.DstRail}}</code></td>
              <td><code>{{.Test.DstIface}}</code></td>
              <td class="{{cellClass .}}">{{cellText . $fam}}</td>
            </tr>
            {{- end}}
          </tbody>
        </table>
      {{- end}}

      {{- $routeDiagnostics := icmpRouteDiagnostics .Matrix.PingResults}}
      {{- if $routeDiagnostics}}
		<div class="matrix-rail">ICMP routing diagnostics</div>
      <table class="matrix-table">
        <thead>
          <tr><th>Source</th><th>Src rail</th><th>Src iface</th><th>Destination</th><th>Dst rail</th><th>Dst iface</th><th>Diagnostic</th></tr>
        </thead>
        <tbody>
          {{- range $routeDiagnostics}}
          <tr>
            <td>{{srcLabel .Result.Test}}</td>
            <td><code>{{.Result.Test.SrcRail}}</code></td>
            <td><code>{{.Result.Test.SrcIface}}</code></td>
            <td>{{dstLabel .Result.Test}}</td>
            <td><code>{{.Result.Test.DstRail}}</code></td>
            <td><code>{{.Result.Test.DstIface}}</code></td>
            <td>{{.Message}}</td>
          </tr>
          {{- end}}
        </tbody>
      </table>
      {{- end}}

      {{- $gpuResults := gpudirectResults .Matrix.PingResults}}
      {{- if $gpuResults}}
      <div class="matrix-rail">GPUDirect DMA-BUF endpoint details</div>
      <table class="matrix-table">
        <thead><tr><th>Source</th><th>Source GPU</th><th>Destination</th><th>Destination GPU</th><th>Bandwidth</th><th>Minimum</th><th>Error</th></tr></thead>
        <tbody>
        {{- range $gpuResults}}
          <tr>
            <td>{{srcLabel .Test}} [{{.Test.SrcRail}}]</td>
            <td>GPU{{.Test.SrcGPUIndex}} {{.Test.SrcGPUPCIAddress}}</td>
            <td>{{dstLabel .Test}} [{{.Test.DstRail}}]</td>
            <td>GPU{{.Test.DstGPUIndex}} {{.Test.DstGPUPCIAddress}}</td>
            <td>{{printf "%.1f" .BandwidthGbps}} Gbps</td>
            <td>{{printf "%.1f" .MinBandwidthGbps}} Gbps</td>
            <td>{{errorText .Err}}</td>
          </tr>
        {{- end}}
        </tbody>
      </table>
      {{- end}}
      {{- else}}
      <p class="empty">No ping tests executed.</p>
      {{- end}}
    {{- else}}
    <p class="empty">Connectivity testing was not run for this report.</p>
    {{- end}}
  </div>
</section>

{{- if .Warnings}}
<section>
  <h2>Warnings ({{len .Warnings}})</h2>
  <div class="body">
    <ul class="warning-list">
      {{- range .Warnings}}
      <li>{{.}}</li>
      {{- end}}
    </ul>
  </div>
</section>
{{- end}}
{{end}}
